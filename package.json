{
  "name": "cocktail-merge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"e2e/**/*.ts\" \"*.{js,ts,json}\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"e2e/**/*.ts\" \"*.{js,ts,json}\" \".prettierrc.json\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsc -p e2e && playwright test"
  },
  "dependencies": {
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
